pipeline {
    agent { 
        label 'master' 
    }
    //parameters {
    //    string defaultValue: 'Szczecin', description: '<b>Podaj swoje miasto by strawdzi pogodę</b>', name: 'MIASTO', trim: true
    //}
    options {
        ansiColor('xterm')
        timestamps()
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scmGit(branches: [[name: '*/main']], extensions: [], userRemoteConfigs: [[url: 'https://accountszkoleniacloud@bitbucket.org/szkoleniacloud/cw-pogoda.git']])
            }
        }
        stage('Display Env') {
            steps {
                sh '''
                  env
                '''
            }
        }
        stage('Nasza pogoda') {
            steps {
                withCredentials([string(credentialsId: 'API_KEY', variable: 'API_KEY')]) {
                    sh '''
                      bash start.sh "Szczecin" ${API_KEY}
                      bash start.sh "Kraków" ${API_KEY}
                    '''
                }
            }
        }
    }
}
