    stages {
        stage('Checkout') {
            steps {
                // checkout scmGit(branches: [[name: '*/main']], extensions: [], userRemoteConfigs: [[url: 'https://accountszkoleniacloud@bitbucket.org/szkoleniacloud/cw-pogoda.git']])
